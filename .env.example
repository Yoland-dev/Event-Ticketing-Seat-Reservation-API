# Copy to .env and adjust. docker-compose reads .env automatically.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string-at-least-50-characters-long
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
API_PORT=8000

POSTGRES_DB=halcyon
POSTGRES_USER=halcyon
POSTGRES_PASSWORD=halcyon-local-only

# Admin account created on first start (skipped if it already exists)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@halcyon.example
DJANGO_SUPERUSER_PASSWORD=HalcyonAdmin!2026

# Loads demo venues, seats and events plus a 'fan' standard user
SEED_DEMO_DATA=true
